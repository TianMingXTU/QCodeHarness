# 大模型服务配置（OpenAI 兼容的 Chat Completions 接口）。
# 复制本文件为 .env 并填入真实值：Copy-Item .env.example .env

# 服务地址（不带路径尾斜杠），请求会发到 {LLM_BASE_URL}/chat/completions。
# 常见取值：
#   DeepSeek   https://api.deepseek.com/v1
#   月之暗面    https://api.moonshot.cn/v1
#   阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 vLLM  http://127.0.0.1:8000/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# API Key（示例值，请改成你自己的）
LLM_API_KEY=sk-your-api-key

# 模型名称，需与服务的模型列表一致，例如 deepseek-chat
LLM_MODEL=deepseek-chat

# ── 按角色分配模型与档位（P11，可选）─────────────────────────────
# 四个角色可以各配各的模型：规划要强推理，测试跑命令读输出就行。
# 没设置的角色用上面的 LLM_MODEL。只影响"用哪个模型"，
# 不影响"能干什么"——角色工具白名单不受此影响。

# LLM_MODEL_PLANNER=deepseek-reasoner
# LLM_MODEL_CODER=deepseek-chat
# LLM_MODEL_TESTER=deepseek-chat
# LLM_MODEL_REVIEWER=deepseek-chat

# 推理档位（minimal / low / medium / high），写错会让进程启动失败。
# 注意：档位会改写请求前缀，前缀缓存会因此失效——同一角色内保持恒定。
# 多数 OpenAI 兼容服务不认这些字段，会被静默忽略（不影响运行）。

# LLM_EFFORT_PLANNER=high
# LLM_EFFORT_TESTER=low

# 输出详略档位（low / medium / high）。

# LLM_VERBOSITY_CODER=low

# 可选：ReAct 循环的最大轮数，默认 20
# LLM_MAX_TURNS=20

# ── 策略与审批（P1）─────────────────────────────────────────────

# 可选：策略配置文件路径（TOML）。未设置时用内置默认策略——
# 只读工具自动放行，非只读工具一律要求人工审批。
# 格式见 README「运行方式」一节。
# QCH_POLICY=policy.toml

# 可选：设为 1 时跳过人工审批，所有工具自动放行。
# 用于 CI 和脚本化运行；本地开发建议留空，让闸门真的拦人。
# QCH_AUTO_APPROVE=1

# ── 上下文与预算（P3）───────────────────────────────────────────

# 可选：墙钟上限（秒）。编排模式下是整个任务的上限，步骤共享这一预算；
# 直接 --resume 时是本次恢复运行的上限。超时后正在执行的轮次会
# 跑完，然后在下一轮问模型之前停下，返回可区分的超时错误。
# 不设置则不限时。
# QCH_MAX_WALL_CLOCK=1800

# 上下文裁剪默认自动生效：发给模型的历史只保留最近 16 轮完整片段，
# 更早的轮次以占位说明代替（最初的任务始终保留）。裁剪不改会话本身，
# 每次裁剪都会在证据里留下 ContextCompacted 事件。

# ── 会话恢复与摘要（P4）─────────────────────────────────────────

# 快照自动保存，无需配置：每轮提交、进审批前、出错前都会把可恢复状态
# 写到 .qcodeharness/snapshots/<会话ID>.json。
#   查看可恢复的会话：cargo run -- --list-sessions
#   从断点继续：      cargo run -- --resume <会话ID>

# 可选：被裁历史累积到多少轮才花一次 LLM 调用生成摘要。设置后，摘要
# 会替代"已省略"占位说明出现在后续请求里；不设置则只做占位说明。
# 摘要失败会自动降级为占位说明，不影响任务继续。
# QCH_SUMMARIZE_MIN_DROPPED=2

# ── 多 Agent 与 MCP（P5）─────────────────────────────────────────

# 角色分发无需配置：四个内置角色（Planner/Coder/Tester/Reviewer）的
# 提示词与工具白名单在 AgentProfile::builtin() 里，编排器按步骤自动装配。

# 可选：MCP 配置文件路径（TOML）。设置后启动时连接其中列出的 stdio
# Server，把它们的工具以 mcp__<server>__<tool> 的名字接进注册表；
# 未设置时 MCP 关闭。格式见 README「MCP 工具」一节。
# QCH_MCP_CONFIG=mcp.toml
